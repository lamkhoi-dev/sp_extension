# Database — leave empty to use local PostgreSQL (postgres://localhost:5432/shopee_affiliate)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# JWT Secret — change in production!
JWT_SECRET=your-secret-key-here

# Server URL — used for report links in Zalo
SERVER_URL=http://your-vps:3456

# Node environment
NODE_ENV=development

# Email Notifications
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
NOTIFY_EMAILS=admin1@example.com,admin2@example.com
