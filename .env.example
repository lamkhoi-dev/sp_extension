# ─── Database ────────────────────────────────────────────
# Leave empty to use local PostgreSQL
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here

# ─── Server ──────────────────────────────────────────────
# Dùng cho report links trong Zalo, redirect URL
SERVER_URL=http://your-vps:3456
PORT=3456

# ─── Environment ─────────────────────────────────────────
# staging | production
NODE_ENV=production

# ─── Shopee Affiliate ────────────────────────────────────
# Affiliate ID của tài khoản Shopee
SHOPEE_AFFILIATE_ID=an_xxxxxxxxxx
# direct | api
LINK_MODE=direct

# ─── Zalo Session ────────────────────────────────────────
# Path đến file session Zalo (mặc định: ./zalo-session.json)
# Staging dùng: ./zalo-session-staging.json
ZALO_SESSION_PATH=./zalo-session.json

# ─── Email Notifications ─────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
NOTIFY_EMAILS=admin1@example.com,admin2@example.com

# ─── Zalo Bot Config ──────────────────────────────────────
# Link nhóm Zalo để mời thành viên mới (hiện trong tin nhắn trả link)
ZALO_GROUP_LINK=https://zalo.me/g/xxxxxxxxx

# ID nhóm chính để gửi thông báo hoàn tiền thành công
# Production: nhóm "💰🧧 Hoàn Tiền 247"
# Staging:    nhóm "TEST HOÀN TIỀN - STAGING"
ZALO_MAIN_GROUP_ID=
