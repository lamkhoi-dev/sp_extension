{
   "action": {
      "default_icon": {
         "128": "/icon/icon128.png",
         "16": "/icon/icon16.png",
         "32": "/icon/icon32.png",
         "48": "/icon/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "/js/background.js"
   },
   "content_scripts": [ {
      "js": [ "js/server-config.js", "js/idb.js", "js/utils.js", "js/content.js" ],
      "matches": [ "https://shopee.vn/*", "https://*.shopee.vn/*" ],
      "run_at": "document_idle"
   }, {
      "css": [ "css/affiliate-product-offer.css" ],
      "js": [ "js/server-config.js", "js/affiliate-product-offer.js" ],
      "matches": [ "https://affiliate.shopee.vn/*" ],
      "run_at": "document_start"
   } ],
   "default_locale": "vi",
   "description": "__MSG_extDesc__",
   "host_permissions": [ "https://affiliate.shopee.vn/*", "https://shopee.vn/*", "https://*.shopee.vn/*" ],
   "icons": {
      "128": "/icon/icon128.png",
      "16": "/icon/icon16.png",
      "32": "/icon/icon32.png",
      "48": "/icon/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
   },
   "permissions": [ "scripting", "activeTab", "tabs", "storage", "notifications", "alarms", "offscreen", "sidePanel", "contextMenus" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.3.0",
   "web_accessible_resources": [ {
      "matches": [ "https://affiliate.shopee.vn/*", "https://shopee.vn/*", "https://*.shopee.vn/*" ],
      "resources": [ "js/chart.min.js", "js/chart.js", "js/price-chart-creator.js", "js/injected-product-offer.js", "js/mcn-manager.js" ]
   } ]
}
